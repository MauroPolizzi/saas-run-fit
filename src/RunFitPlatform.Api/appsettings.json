{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "TimeZone": "America/Argentina/Buenos_Aires"
  },
  "Database": {
    "MigrateOnStartup": false,
    "CommandTimeoutSeconds": 30
  },
  "Auth": {
    "SessionDays": 14,
    "AdminSessionHours": 8,
    "InvitationExpiryDays": 7,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "SecurityStampValidationMinutes": 5
  },
  "Email": {
    "FromName": "Run Fit Platform"
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "PasswordRecovery": {
      "PermitLimit": 5,
      "WindowSeconds": 900
    },
    "InvitationAcceptance": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Admin": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  },
  "ReverseProxy": {
    "KnownNetworks": []
  }
}
