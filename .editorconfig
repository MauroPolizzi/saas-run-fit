root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{cs,csx}]
indent_size = 4

[*.{csproj,props,targets,slnx,xml}]
indent_size = 2

# ---------------------------------------------------------------------------
# C#: estilo
# ---------------------------------------------------------------------------
[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_prefer_braces = when_multiline:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning

# Campos privados en camelCase con guion bajo
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel
dotnet_naming_rule.private_fields.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_rule.private_constants.symbols = private_constants
dotnet_naming_rule.private_constants.style = pascal
dotnet_naming_rule.private_constants.severity = warning
dotnet_naming_symbols.private_constants.applicable_kinds = field
dotnet_naming_symbols.private_constants.applicable_accessibilities = private
dotnet_naming_symbols.private_constants.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.private_static_readonly.symbols = private_static_readonly
dotnet_naming_rule.private_static_readonly.style = pascal
dotnet_naming_rule.private_static_readonly.severity = warning
dotnet_naming_symbols.private_static_readonly.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly.required_modifiers = static, readonly

# ---------------------------------------------------------------------------
# C#: ajustes de analizadores (AnalysisMode = Recommended)
# ---------------------------------------------------------------------------
# ASP.NET Core no usa SynchronizationContext: ConfigureAwait no aporta.
dotnet_diagnostic.CA2007.severity = none
# Los tipos públicos son necesarios para Minimal APIs, OpenAPI y WebApplicationFactory.
dotnet_diagnostic.CA1515.severity = none
# Mensajes de log de alto volumen se optimizan con LoggerMessage cuando hagan falta.
dotnet_diagnostic.CA1848.severity = suggestion
# Records anidados Request/Response/Handler dentro de la clase del caso de uso (convención del proyecto).
dotnet_diagnostic.CA1034.severity = none
# Textos de interfaz y logs no se localizan en el MVP (español fijo).
dotnet_diagnostic.CA1303.severity = none
# Las clases de opciones exponen colecciones configurables desde appsettings.
dotnet_diagnostic.CA2227.severity = none
dotnet_diagnostic.CA1819.severity = none
# Uri como string en opciones de configuración.
dotnet_diagnostic.CA1056.severity = none
dotnet_diagnostic.CA1054.severity = none
# "Shared" es palabra clave de VB; el proyecto es solo C# y la carpeta Shared es parte del diseño.
dotnet_diagnostic.CA1716.severity = none
# Los logs con argumentos calculados ya se protegen con logger.IsEnabled.
dotnet_diagnostic.CA1873.severity = suggestion
# Clases instanciadas por DI o por EF.
dotnet_diagnostic.CA1812.severity = none

# Migraciones generadas por EF Core
[**/Persistence/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
[tests/**.cs]
# Nombres de tests con guion bajo: Metodo_Escenario_Resultado.
dotnet_diagnostic.CA1707.severity = none
# Los tests no validan argumentos públicos.
dotnet_diagnostic.CA1062.severity = none
# Las fixtures de xUnit se instancian por reflexión.
dotnet_diagnostic.CA1001.severity = suggestion
# Literales de URI en tests.
dotnet_diagnostic.CA2234.severity = none
